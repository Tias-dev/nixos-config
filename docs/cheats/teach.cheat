% teach


# Send credentials to student
sendStudPass() {
email="$1"
login="$2"
pass="$3"
message=$(cat <<EOF
From: www.tias.dev@gmail.com
Subject: Креды для сервисов ФИ

Привет, это письмо я прислал через скрипт, так что возможно перепутал получателя

По идее у тебя должна быть почта: $email
И твоя ФамилияИО в транслите на английский будет: $login

Если всё так, значит я правильно определил получателя.

В общем смотри. У нас по курсу будет 2 основных сервиса:

- Гит репозиторий: git.tias-dev.tech
- Чат мессенджер: chat.tias-dev.tech

От этих сервисов у тебя уже есть логин и пароль: $login $pass

Я эти данные сохранил, на случай неожиданностей, так что когда зайдешь на сервисы -- обнови пароль

P.S. Если я напутал почту или ФИО -- тыкни старосту, а она тыкнет меня
P.S.S. В мессенджере я уже отправил приглашение в наше пространство. Если не увидишь -- тыкни старосту
P.S.S.S. В мессенджере можно использовать веб морду chat.tias-dev.tech, или скачать приложение на телефон(Element Classic)
P.S.S.S.S. Мессенджер по умолчанию хочет войти через сайт matrix.org, который заблокирован и тебе возможно понадобиться VPN для первого захода. На matrix.org регистрироваться НЕ НАДО. Замени сервер matrix.org -> tias-dev.tech и войди по логину - паролю.

----

Отправил через скрипт Бучкин Тимур Артемович, твой преподаватель по ФИ

EOF
) && echo "$message" | msmtp $1
}

# Add student to forgejo team
addStudToGroup() {
    https_proxy= http_proxy= all_proxy= fj -H git.tias-dev.tech org team member add OpenCode Students $1
}

# Register student to matrix
registerStudentsMatrix() {
    group="$1"
    cat "$group" | while read line; do
        name=$(echo $line | cut -d',' -f 1)
        email=$(echo $line | cut -d',' -f 2)
        pass=$(echo $line | cut -d',' -f 3)
        register_new_matrix_user -k "$(cat /run/secrets/matrix-shared-secret)" -u $name -p $pass --exists-ok --no-admin
    done
}

# Register student to forgejo(under forgejo user)
registerStudentsForgejo() {
    group="$1"
    cat "$group" | while read line; do 
        name=$(echo $line | cut -d',' -f 1)
        email=$(echo $line | cut -d',' -f 2)
        pass=$(echo $line | cut -d',' -f 3)
        forgejo -c ./custom/conf/app.ini admin user create --username $name --password $pass --email $email
 done
}

# Convert FamilyIO to eng translit
translitFio() {
    family="$1"
    name="$2"
    father="$3"
    echo "$(rutranslit text $(echo $family))$(rutranslit text $(echo $name) | cut -c-1)$(rutranslit text $(echo $father) | cut -c-1)"
}
